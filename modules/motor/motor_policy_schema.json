{
  "title": "Motor Policy Schema",
  "type": "object",
  "required": [
    "policy",
    "policyholder",
    "vehicle",
    "coverage",
    "premium"
  ],
  "properties": {
    "policy": {
      "type": "object",
      "required": [
        "policy_number",
        "product_type",
        "inception_date",
        "expiry_date",
        "status",
        "currency"
      ],
      "properties": {
        "policy_number": { "type": "string" },
        "product_type": { "type": "string", "const": "motor" },
        "inception_date": { "type": "string", "format": "date" },
        "expiry_date": { "type": "string", "format": "date" },
        "status": {
          "type": "string",
          "enum": ["draft", "quoted", "active", "lapsed", "cancelled", "expired", "void"]
        },
        "currency": {
          "type": "string",
          "enum": ["GBP", "EUR", "USD"]
        }
      },
      "additionalProperties": false
    },
    "policyholder": {
      "$ref": "#/$defs/person_party"
    },
    "insured": {
      "$ref": "#/$defs/person_party"
    },
    "vehicle": {
      "type": "object",
      "required": [
        "registration_number",
        "make",
        "model",
        "year_of_manufacture",
        "body_type",
        "fuel_type",
        "transmission_type"
      ],
      "properties": {
        "registration_number": { "type": "string" },
        "vehicle_identification_number": { "type": "string" },
        "make": { "type": "string" },
        "model": { "type": "string" },
        "variant": { "type": "string" },
        "year_of_manufacture": { "type": "integer" },
        "body_type": {
          "type": "string",
          "enum": ["hatchback", "saloon", "estate", "suv", "coupe", "convertible", "van", "pickup", "other"]
        },
        "fuel_type": {
          "type": "string",
          "enum": ["petrol", "diesel", "hybrid", "electric", "plug_in_hybrid", "other"]
        },
        "transmission_type": {
          "type": "string",
          "enum": ["manual", "automatic", "semi_automatic", "other"]
        },
        "engine_size_cc": { "type": "integer" },
        "market_value": { "type": "number" },
        "purchase_date": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "drivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/driver" }
    },
    "vehicle_usage": {
      "type": "object",
      "properties": {
        "usage_type": {
          "type": "string",
          "enum": [
            "social_domestic_pleasure",
            "commuting",
            "business_use_class_1",
            "business_use_class_2",
            "business_use_class_3",
            "commercial_use"
          ]
        },
        "annual_mileage": { "type": "integer" },
        "commuting_flag": { "type": "boolean" },
        "business_use_flag": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "garaging": {
      "type": "object",
      "properties": {
        "garaging_type": {
          "type": "string",
          "enum": ["roadside", "driveway", "private_garage", "car_park", "gated_compound", "other"]
        },
        "postcode": { "type": "string" },
        "overnight_location_same_as_home_flag": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "no_claims_discount": {
      "type": "object",
      "properties": {
        "years_of_no_claims": { "type": "integer" },
        "protected_flag": { "type": "boolean" },
        "proof_provided_flag": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "security_devices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "device_type": {
            "type": "string",
            "enum": ["alarm", "immobiliser", "tracker", "dashcam", "steering_lock", "other"]
          },
          "approved_flag": { "type": "boolean" },
          "installation_date": { "type": "string", "format": "date" }
        },
        "additionalProperties": false
      }
    },
    "vehicle_modifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modification_type": {
            "type": "string",
            "enum": ["performance", "cosmetic", "accessibility", "security", "bodywork", "audio", "wheels", "other"]
          },
          "modification_description": { "type": "string" },
          "declared_flag": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": ["cover_basis"],
      "properties": {
        "cover_basis": {
          "type": "string",
          "enum": ["third_party_only", "third_party_fire_and_theft", "comprehensive"]
        },
        "own_damage_included": { "type": "boolean" },
        "third_party_included": { "type": "boolean" },
        "fire_included": { "type": "boolean" },
        "theft_included": { "type": "boolean" },
        "windscreen_included": { "type": "boolean" },
        "courtesy_car_included": { "type": "boolean" },
        "breakdown_assistance_included": { "type": "boolean" },
        "foreign_use_included": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "premium": {
      "type": "object",
      "required": ["amount", "currency", "payment_frequency"],
      "properties": {
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["GBP", "EUR", "USD"] },
        "payment_frequency": {
          "type": "string",
          "enum": ["single", "weekly", "monthly", "quarterly", "half_yearly", "annual"]
        }
      },
      "additionalProperties": false
    },
    "excess": {
      "type": "object",
      "properties": {
        "compulsory_excess_amount": { "type": "number" },
        "voluntary_excess_amount": { "type": "number" },
        "total_excess_amount": { "type": "number" }
      },
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "person_party": {
      "type": "object",
      "required": ["party_type", "full_name"],
      "properties": {
        "party_type": { "type": "string", "enum": ["person"] },
        "full_name": { "type": "string" },
        "date_of_birth": { "type": "string", "format": "date" },
        "marital_status": {
          "type": "string",
          "enum": ["single", "married", "civil_partner", "divorced", "widowed", "other"]
        },
        "postcode": { "type": "string" }
      },
      "additionalProperties": true
    },
    "driver": {
      "type": "object",
      "required": ["full_name", "date_of_birth", "licence_type"],
      "properties": {
        "full_name": { "type": "string" },
        "date_of_birth": { "type": "string", "format": "date" },
        "licence_type": {
          "type": "string",
          "enum": ["provisional", "full_uk", "full_eu", "full_non_eu", "international", "other"]
        },
        "licence_issue_date": { "type": "string", "format": "date" },
        "occupation": { "type": "string" },
        "marital_status": {
          "type": "string",
          "enum": ["single", "married", "civil_partner", "divorced", "widowed", "other"]
        },
        "years_licensed": { "type": "integer" },
        "claims_history_count": { "type": "integer" },
        "conviction_count": { "type": "integer" },
        "relationship_to_policyholder": { "type": "string" },
        "is_main_driver": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "required": ["document_id", "document_type", "document_title"],
      "properties": {
        "document_id": { "type": "string" },
        "document_type": {
          "type": "string",
          "enum": [
            "policy_wording",
            "schedule",
            "endorsement",
            "proposal_form",
            "certificate",
            "claim_form",
            "supporting_evidence",
            "statement",
            "scheme_document",
            "member_statement",
            "scheme_booklet"
          ]
        },
        "document_title": { "type": "string" },
        "issue_date": { "type": "string", "format": "date" },
        "version_number": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
